# روابط نظيفة للصنايعية: saqapp.net/اسم_المستخدم  (الملفات والمجلدات الموجودة لا تتأثر)
RewriteEngine On
# أزل الشرطة الأخيرة حتى تبقى مسارات الملفات النسبية سليمة
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z][a-zA-Z0-9_]{2,19})/$ /$1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z][a-zA-Z0-9_]{2,19})$ /index.html [L]
