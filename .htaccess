# روابط نظيفة للصنايعية: saqapp.net/اسم_المستخدم  (الملفات والمجلدات الموجودة لا تتأثر)
RewriteEngine On
# أزل الشرطة الأخيرة حتى تبقى مسارات الملفات النسبية سليمة
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z][a-zA-Z0-9_]{2,19})/$ /$1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z][a-zA-Z0-9_]{2,19})$ /index.html [L]

# الصفحات والسكربتات تُراجَع مع كل فتح حتى يصل التحديث فورًا
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
