# الجذر: صفحة البوابة. التطبيق داخل /sanayei/
RewriteEngine On
# روابط الصنايعية القديمة saqapp.net/اسم → saqapp.net/sanayei/اسم (الملفات والمجلدات الموجودة لا تتأثر)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z][a-zA-Z0-9_]{2,19})/?$ /sanayei/$1 [R=302,L]

# الصفحات والسكربتات تُراجَع مع كل فتح حتى يصل التحديث فورًا
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
