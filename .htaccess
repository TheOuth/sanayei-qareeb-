# الجذر: بوابة سبيل. كل خدمة داخل مجلدها (صنايعي قريب في /sanayei/) ولا يُخلط بينها.
RewriteEngine On

# أي مسار غير موجود: صفحة 404 (تحوّل مسارات /sanayei/ إلى الخدمة نفسها، وغيرها تبقى في سبيل)
ErrorDocument 404 /404.html

# الصفحات والسكربتات تُراجَع مع كل فتح حتى يصل التحديث فورًا
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|json|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
